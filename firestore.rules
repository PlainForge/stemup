rules_version = '2';

// StemUp access levels: User < Instructor < Admin.
//   Admins:      ids in admins/all-perms (set by a developer in the console only)
//   Instructors: ids in admins/instructors (set by admins from the Admin page)
//   A role's instructors are listed in roles/{id}.instructors; an Instructor can
//   run only the roles they're listed on. Admins can do everything.
//   A role's owner (roles/{id}.owner, set by admins or handed on by the current
//   owner) is one of its instructors and makes the bigger changes to it; its
//   other instructors request those.
//
// Deploy with: firebase deploy --only firestore:rules
// This replaces whatever rules are in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function isAdmin() {
      return signedIn() && me() in get(/databases/$(database)/documents/admins/all-perms).data.get('ids', []);
    }
    function isInstructor() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/instructors)
        && me() in get(/databases/$(database)/documents/admins/instructors).data.get('ids', []);
    }
    // Admins, or an Instructor listed on this role
    function runsRole(roleId) {
      return isAdmin() || (isInstructor()
        && exists(/databases/$(database)/documents/roles/$(roleId))
        && me() in get(/databases/$(database)/documents/roles/$(roleId)).data.get('instructors', []));
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // The only difference between two lists is the signed-in user
    function onlyMeChanged(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([me()])
        && before.toSet().difference(after.toSet()).hasOnly([me()]);
    }

    // Admins can read and write everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == userId;
      allow delete: if signedIn() && me() == userId;
      // Your own profile, but not your own points, tasks completed or role list
      allow update: if signedIn() && me() == userId
        && changes().hasOnly(['name', 'photoURL', 'currentRole', 'showGlobalLeaderboard', 'email', 'pendingEmail', 'notifications', 'hideOnHome', 'aboutMe'])
        // About Me is short (200 words, checked in the apps and by the cleanProfileName function)
        && (!('aboutMe' in request.resource.data) || (request.resource.data.aboutMe is string && request.resource.data.aboutMe.size() <= 1500));
      // canSeeGlobal (seeing the global leaderboard) is set by admins only (above)
      // Instructors award points, edit stats, accept members and remove them
      allow update: if isInstructor()
        && changes().hasOnly(['roles', 'points', 'taskCompleted', 'currentRole']);

      // Push tokens for your own phones (read by Cloud Functions to send notifications)
      match /devices/{deviceId} {
        allow read, write: if signedIn() && me() == userId;
      }
    }

    match /admins/{docId} {
      allow read: if signedIn();
      // Only admins (above) write here
    }

    // A role's owner is the instructor in `owner`, set by admins; roles from before
    // owners existed fall back to the instructor who created them
    function roleOwner(data) { return data.get('owner', data.get('createdBy', '')); }
    function ownsRoleData(data) {
      return isInstructor() && roleOwner(data) == me() && me() in data.get('instructors', []);
    }
    function ownsRole(roleId) {
      return roleId is string && roleId != ''
        && exists(/databases/$(database)/documents/roles/$(roleId))
        && ownsRoleData(get(/databases/$(database)/documents/roles/$(roleId)).data);
    }

    // Only the role's owner may take other instructors off it, and no instructor
    // may take themselves off (admins can, via their own rule)
    function instructorRemovalsAllowed() {
      let removed = resource.data.get('instructors', []).toSet()
        .difference(request.resource.data.get('instructors', []).toSet());
      return removed.size() == 0
        || (!(me() in removed) && ownsRoleData(resource.data));
    }

    // Instructors who don't own the role ask the owner to rename it, change the
    // rewards title or its icon, or kick members. Admins choose the owner; the owner can also
    // hand the role on to another of its instructors.
    function ownerOnlyChangesAllowed() {
      return !changes().hasAny(['createdBy'])
        && (!changes().hasAny(['owner'])
            || (ownsRoleData(resource.data)
                && request.resource.data.get('owner', '') in resource.data.get('instructors', [])))
        && (ownsRoleData(resource.data)
            || (!changes().hasAny(['name', 'rewardsTitle', 'icon', 'iconColor', 'inviteOnly'])
                && resource.data.get('members', []).toSet()
                     .difference(request.resource.data.get('members', []).toSet()).size() == 0));
    }

    // Only people already in the role can be made its instructors
    function instructorAdditionsAreMembers() {
      let added = request.resource.data.get('instructors', []).toSet()
        .difference(resource.data.get('instructors', []).toSet());
      return added.difference(resource.data.get('members', []).toSet()).size() == 0;
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow update: if runsRole(roleId) && instructorRemovalsAllowed() && instructorAdditionsAreMembers()
        && ownerOnlyChangesAllowed();
      // Anyone can ask to join (or withdraw), leave a role, or join the global role
      allow update: if signedIn()
        && changes().hasOnly(['members', 'pendingRequests'])
        && onlyMeChanged(resource.data.get('members', []), request.resource.data.get('members', []))
        && onlyMeChanged(resource.data.get('pendingRequests', []), request.resource.data.get('pendingRequests', []))
        // Invite-only roles take no new join requests (withdrawing one is still fine)
        && (!resource.data.get('inviteOnly', false)
            || request.resource.data.get('pendingRequests', []).toSet()
                 .difference(resource.data.get('pendingRequests', []).toSet()).size() == 0)
        && (roleId == 'r3wUbRSCX7cxwBYhtAdg'
            || request.resource.data.get('members', []).toSet().difference(resource.data.get('members', []).toSet()).size() == 0);
      // Creating and deleting roles is admin-only (above)
    }

    match /rewards/{roleId} {
      allow read: if signedIn();
      allow write: if runsRole(roleId);
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if runsRole(request.resource.data.roleId);
      allow update, delete: if runsRole(resource.data.roleId);
      // The person doing the task sets its status, asks for an extension, and
      // (when submitting an overdue task) stops it auto-deleting
      allow update: if signedIn() && resource.data.assignedTo == me()
        && changes().hasOnly(['status', 'extensionRequested', 'deleteAt']);
      // Deleting your account removes your tasks
      allow delete: if signedIn() && resource.data.assignedTo == me();
    }

    match /tasksSubmitted/{taskId} {
      allow read: if signedIn();
      // Submitting your own task, for the points it's actually worth
      allow create: if signedIn()
        && request.resource.data.assignedTo == me()
        && request.resource.data.complete == false
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo == me()
        && request.resource.data.points == get(/databases/$(database)/documents/tasks/$(taskId)).data.points
        && request.resource.data.roleId == get(/databases/$(database)/documents/tasks/$(taskId)).data.roleId;
      allow update, delete: if runsRole(resource.data.roleId);
      allow delete: if signedIn() && resource.data.assignedTo == me();
    }

    // Saved Data (role resets). The role's owner resets it; admins can too.
    match /leaderboardSnapshots/{snapId} {
      allow read: if signedIn();
      allow create: if ownsRole(request.resource.data.roleId);
    }

    // Requests. Admins approve Instructor access and new roles. Changes to a role
    // (reset, rename, editing a member's stats, kicking, the rewards title) go to
    // the role's owner, or to admins when it has none.
    match /requests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == me() || isInstructor());
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && (request.resource.data.type == 'instructor'
            || (request.resource.data.type == 'createRole' && isInstructor())
            || (request.resource.data.type in ['resetRole', 'renameRole', 'editStats', 'kickMember', 'rewardsTitle', 'roleIcon']
                && runsRole(request.resource.data.roleId)));
      // Withdrawing your own request
      allow delete: if signedIn() && resource.data.uid == me();
      // The role's owner approves or declines: records the decision, then removes it
      allow update: if ownsRole(resource.data.get('roleId', '')) && changes().hasOnly(['status']);
      allow delete: if ownsRole(resource.data.get('roleId', ''));
    }

    // Invitations to join a role, as a member or one of its instructors
    // (invites/{roleId}_{uid}). The role's instructors and admins send and cancel
    // them; the person invited declines by deleting it, or accepts through the
    // respondToInvite Cloud Function, which adds them to the role.
    match /invites/{inviteId} {
      allow read: if signedIn() && (resource.data.uid == me() || runsRole(resource.data.roleId));
      allow create: if runsRole(request.resource.data.roleId)
        && request.resource.data.invitedBy == me()
        && inviteId == request.resource.data.roleId + '_' + request.resource.data.uid
        && (request.resource.data.as == 'member'
            || (request.resource.data.as == 'instructor'
                && request.resource.data.uid in get(/databases/$(database)/documents/admins/instructors).data.get('ids', [])));
      allow delete: if signedIn() && (resource.data.uid == me() || runsRole(resource.data.roleId));
    }

    match /bugs/{bugId} {
      // Bug reports and feature requests ('type'; older reports have none and are bugs)
      allow create: if signedIn() && request.resource.data.userId == me()
        && request.resource.data.get('type', 'bug') in ['bug', 'feature'];
    }

    // Inactive Users archives (alumni/{batch}/members/{uid}) are admin-only (above).
    // emailThrottle is written by Cloud Functions only.
  }
}
